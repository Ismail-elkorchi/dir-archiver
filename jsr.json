{
  "name": "@ismail-elkorchi/dir-archiver",
  "version": "4.0.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "@ismail-elkorchi/bytefold": "jsr:@ismail-elkorchi/bytefold@^0.9.0"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
      "BREAKING_CHANGES.md",
      "SECURITY.md",
      "docs/api.md",
      "docs/cli.md",
      "docs/safety.md",
      "docs/formats.md",
      "docs/troubleshooting.md",
      "src/**",
      "jsr.json"
    ],
    "exclude": [
      "dist/**",
      "test/**",
      "node_modules/**",
      ".github/**",
      "src/cli.ts"
    ]
  }
}
